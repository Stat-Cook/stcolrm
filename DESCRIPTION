Package: stcolrm
Type: Package 
Title: Calculating standardised coefficients for logistic regression models
Version: 0.1.0
Authors@R: c(
    person("Robert", "Cook", role = c("aut"), comment = c(ORCID = "0000-0003-3343-8271")),
    person(given = "Asaduzzaman", family = "Md", role = c("aut","cre"), email = "asad.mdaz@gmail.com")
